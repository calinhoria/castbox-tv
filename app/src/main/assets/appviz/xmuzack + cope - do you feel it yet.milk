shape_3_per_frame2=ang = -(q4-q5)*0.2;
shape_3_per_frame3=
shape_3_per_frame4=pi3 = 3.1415*2*0.3333;
shape_3_per_frame5=
shape_3_per_frame6=t = (q4-2*q5+q6)*0.2;
shape_3_per_frame7=c=3;
shape_3_per_frame8=r = sin(t)*c;
shape_3_per_frame9=
shape_3_per_frame10=g = sin(t+pi3)*c;
shape_3_per_frame11=
shape_3_per_frame12=b = sin(t-pi3)*c;
shape_3_per_frame13=
shape_3_per_frame14=
shape_3_per_frame15=r = if(above(r,1),1,r);
shape_3_per_frame16=r = if(below(r,0),0,r);
shape_3_per_frame17=g = if(above(g,1),1,g);
shape_3_per_frame18=g = if(below(g,0),0,g);
shape_3_per_frame19=b = if(above(b,1),1,b);
shape_3_per_frame20=b = if(below(b,0),0,b);
shape_3_per_frame21=
shape_3_per_frame22=r2 = 1-r;
shape_3_per_frame23=g2 = 1-g;
shape_3_per_frame24=b2 = 1-b;
per_frame_1=//Yndi Halda - We Flood Empty Lakes
per_frame_2=
per_frame_3=vol=(bass+mid+treb)*0.25;
per_frame_4=vol=vol*vol;
per_frame_5=
per_frame_6=
per_frame_7=mtime=mtime+vol*0.01;
per_frame_8=q3=mtime*0.25;
per_frame_9=
per_frame_10=vola = 0.1*(vola*9 + (bass_att+mid_att+treb_att)*0.333333);
per_frame_11=q1 = vola;
per_frame_12=
per_frame_13=q6 = 0.5 + 0.3*sin(-time*2);
per_frame_14=q7 = 0.5 + 0.3*cos(-time);
per_frame_15=
per_frame_16=monitor = bass_thresh;
per_frame_17=
per_frame_18=zoom = zoom + 0.05*vol;
per_frame_19=wave_x = wave_x + 0.5*sin(mtime*2);
per_frame_20=wave_y = wave_y + 0.5*sin(-mtime*1.34);
warp_1=`sampler sampler_herb_leaf;
warp_2=`
warp_3=`shader_body
warp_4=`{
warp_5=`    // sample previous frame
warp_6=`   ret = tex2D( sampler_herb_leaf, uv);
warp_7=`}
comp_1=`#define sat saturate
comp_2=`float dist, struc, height,snow;
comp_3=`float2 dz, dz1, uv0, uv1, uv3;
comp_4=`float3 rsl, mod, ret0;
comp_5=`float  lav_gnd;
comp_6=`static const float hory = q6, xyscale = q7, alti = q8, dir = q2;
comp_7=`static const float2 modran = float2 (q15,q16);
comp_8=`
comp_9=`static const float2 hor = texsize.zw*float2 (1,0);;
comp_10=`static const float2 ver = texsize.zw*float2 (0,1);;
comp_11=`static const float3 mov = float3 (q10,q11,0);
comp_12=`
comp_13=`float2 noise2 (float2 uvi, float h) {float2 tmp = 0; float s = 1;
comp_14=`  for (int n = 1; n <= 3; n +=1 ) {tmp += tex2D(sampler_noise_mq,(uvi)*s+time*0.003)/s; s*= 3+h*-0.0;}
comp_15=`  return sat (abs(tmp*-1)-0.2);}
comp_16=`
comp_17=`float3 rs_lav (float2 uvi, float berg) {  float z; float2 rs;
comp_18=`  z = 1/(uvi.y+hory)*(alti-berg*16); //z = clamp(z,0,4/xyscale);
comp_19=`  rs.x = uvi.x * 2*z ; rs.y = z; 
comp_20=`  return float3(rs*xyscale,z)+mov*1; }
comp_21=`
comp_22=`float3 GetBlur0 (float2 uvi)
comp_23=` {return (GetPixel(uvi) + GetPixel(uvi +hor) + GetPixel(uvi -hor) + GetPixel(uvi +ver) + GetPixel(uvi -ver))/5; }
comp_24=`
comp_25=`
comp_26=`shader_body {
comp_27=`//uv += texsize.zw/2;
comp_28=`uv0 = uv;
comp_29=`rsl = rs_lav (uv-0.5,-GetBlur1(uv).b+modran.yx);
comp_30=`mod = tex2D(sampler_noise_mq, rsl*0.1);
comp_31=`
comp_32=`ret0 = GetPixel(uv);
comp_33=`dist = ret0.g;
comp_34=`struc = ret0.r;
comp_35=`height = 1-ret0.b;
comp_36=`snow = abs (height-GetBlur1(uv).b)* (2*height*(0.0+struc))/dist*1;
comp_37=`
comp_38=`//###########################
comp_39=`ret = ret0;;
comp_40=`
comp_41=`ret.r = lerp (ret0.r,GetBlur1(uv).r,sat(2-6*(ret0.g+ret0.b*0.25))) ;
comp_42=`
comp_43=`ret.b = pow (ret0.b,3)/2 + ret.r/2;
comp_44=`ret.g = pow (ret0.g,1.2) /2+ ret.r/2;
comp_45=`ret.rg = sat (ret.rg+lum(ret)/2) + ret.b*(mod.z-0.3)*0.5;
comp_46=`
comp_47=`ret += ret0.r *pow (height,2)* float3 (1, 1, 2)*2*sat(2-dist)*mod.x; //snow
comp_48=`//ret += snow;
comp_49=`
comp_50=`
comp_51=`ret *= 0.8;
comp_52=`
comp_53=`//wolken
comp_54=`rsl = rs_lav (uv-0.5,- sat(GetBlur1(uv).b*0.7));
comp_55=`ret += noise2(3*rsl,GetBlur1(uv).b).x * saturate (4*ret0.b-3) / abs(rsl.z)*3*mod.y;
comp_56=`
comp_57=`//Sonne
comp_58=`ret += sat(0.12/sqrt (length (uv-float2 (q2,0.58-q6))) * saturate (1-height*1 + dist*2-1)) ;
comp_59=`//ret += pow (lerp (1-uv.x,uv.x,dir)*(1-uv.y),4) * saturate (GetPixel(uv).b*5 +GetPixel(uv).g*2-1) * float3(1,0.5,0.14);
comp_60=`
comp_61=`
comp_62=`
comp_63=`}
comp_64=`ret = pow (struc, float3 (1,1.5,1.26));;
comp_65=`ret = lerp (ret, 1, pow(1-height,3));
comp_66=`ret = lerp (ret, float3 (0,0.5,.1), sat(dist*1));
comp_67=`
comp_68=`
