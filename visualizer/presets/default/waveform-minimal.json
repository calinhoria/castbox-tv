{
  "version": 1,
  "name": "Waveform minimal",
  "author": "built-in",
  "palette": "Ice",
  "components": [
    {
      "type": "background",
      "props": {
        "image": "{cover}",
        "fit": 1,
        "x": 0,
        "y": 0,
        "w": 1,
        "h": 1,
        "opacity": 1,
        "mode": 0,
        "color": "{bg}"
      }
    },
    {
      "type": "line",
      "props": {
        "linePoints": 256,
        "strokeWidth": 0.006,
        "smoothing": 0.2,
        "gain": 1.6,
        "fillColor": "{primary}",
        "fillOpacity": 0.18,
        "x": 0.05,
        "y": 0.3,
        "w": 0.9,
        "h": 0.34,
        "opacity": 1,
        "lineMode": 0,
        "color": "{text}",
        "gradient": true,
        "color2": "{primary}",
        "fill": true
      }
    },
    {
      "type": "text",
      "props": {
        "pattern": "{title}",
        "size": 0.05,
        "weight": 700,
        "color": "{text}",
        "shadow": false,
        "shadowColor": "#000000",
        "shadowBlur": 8,
        "shadowOffset": 3,
        "marqueeSpeed": 45,
        "marqueeGap": 0.5,
        "marqueePause": 5,
        "x": 0.05,
        "y": 0.72,
        "w": 0.6,
        "h": 0.08,
        "opacity": 1,
        "align": 0,
        "marquee": true
      }
    },
    {
      "type": "text",
      "props": {
        "pattern": "{artist} · {album}",
        "size": 0.026,
        "weight": 300,
        "color": "{accent}",
        "shadow": false,
        "shadowColor": "#000000",
        "shadowBlur": 8,
        "shadowOffset": 3,
        "marqueeSpeed": 30,
        "marqueeGap": 0.5,
        "marqueePause": 5,
        "x": 0.05,
        "y": 0.81,
        "w": 0.6,
        "h": 0.06,
        "opacity": 1,
        "align": 0,
        "marquee": true
      }
    },
    {
      "type": "meter",
      "props": {
        "thickness": 0.03,
        "cornerRadius": 1,
        "trackColor": "{text}",
        "trackOpacity": 0.12,
        "x": 0.05,
        "y": 0.92,
        "w": 0.9,
        "h": 0.008,
        "opacity": 1,
        "source": 0,
        "direction": 0,
        "color": "{primary}"
      }
    },
    {
      "type": "text",
      "props": {
        "pattern": "{position} / {duration}",
        "size": 0.02,
        "weight": 300,
        "color": "{accent}",
        "shadow": false,
        "shadowColor": "#000000",
        "shadowBlur": 8,
        "shadowOffset": 3,
        "marqueeSpeed": 40,
        "marqueeGap": 0.5,
        "marqueePause": 5,
        "x": 0.05,
        "y": 0.895,
        "w": 0.9,
        "h": 0.04,
        "opacity": 1,
        "align": 2
      }
    }
  ]
}
